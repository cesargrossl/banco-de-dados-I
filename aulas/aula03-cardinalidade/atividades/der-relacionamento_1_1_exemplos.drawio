        <mxCell id="fk2" edge="1" parent="1" source="tbl_arm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;" value="FK aponta para PROFESSOR.id_professor">
