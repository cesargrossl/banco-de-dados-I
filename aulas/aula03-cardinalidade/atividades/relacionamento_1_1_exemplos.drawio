        <mxCell id="c22" value="(1,1)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="80" height="30" as="geometry"/></mxCell>

        <mxCell id="logical2" value="Modelo lógico — opção escolhida" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="tbl_prof" value="&lt;b&gt;PROFESSOR&lt;/b&gt;&lt;hr/&gt;PK id_professor&lt;br/&gt;nome" style="shape=swimlane;html=1;rounded=0;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="120" y="310" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="tbl_arm" value="&lt;b&gt;ARMARIO&lt;/b&gt;&lt;hr/&gt;PK id_armario&lt;br/&gt;numero&lt;br/&gt;FK id_professor UNIQUE NOT NULL" style="shape=swimlane;html=1;rounded=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="310" height="140" as="geometry"/></mxCell>
        <mxCell id="fk2" value="FK aponta para PROFESSOR.id_professor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tbl_arm" target="tbl_prof"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="explain2" value="&lt;b&gt;Explicação&lt;/b&gt;&lt;br/&gt;• Os dois lados são obrigatórios: (1,1) e (1,1).&lt;br/&gt;• Tecnicamente, a FK poderia ficar em qualquer uma das duas tabelas.&lt;br/&gt;• Aqui foi colocada em ARMARIO porque faz sentido perguntar: ‘este armário pertence a qual professor?’.&lt;br/&gt;• UNIQUE impede que dois armários sejam associados ao mesmo professor.&lt;br/&gt;• Em um 1:1 obrigatório dos dois lados, a decisão é principalmente de semântica e regra de negócio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="500" width="840" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
