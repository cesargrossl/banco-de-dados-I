        <mxCell id="fk1" value="FK aponta para PESSOA.id_pessoa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=13;" edge="1" parent="1" source="tbl_pass" target="tbl_pessoa"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="explain1" value="&lt;b&gt;Explicação&lt;/b&gt;&lt;br/&gt;• Uma pessoa pode existir sem passaporte.&lt;br/&gt;• Um passaporte não deve existir sem uma pessoa.&lt;br/&gt;• Por isso, a FK fica em PASSAPORTE.&lt;br/&gt;• UNIQUE garante que uma pessoa tenha no máximo um passaporte.&lt;br/&gt;• NOT NULL garante que todo passaporte esteja ligado a uma pessoa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="140" y="500" width="780" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

