        <mxCell id="r2t" value="Relacionamento fraco/identificador: liga uma entidade fraca à entidade da qual ela depende. É representado por losango duplo." style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="810" y="260" width="280" height="70" as="geometry"/></mxCell>

