        <mxCell id="e2t" value="Entidade fraca: depende de uma entidade forte para existir e é representada por retângulo duplo." style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="225" width="290" height="60" as="geometry"/></mxCell>

