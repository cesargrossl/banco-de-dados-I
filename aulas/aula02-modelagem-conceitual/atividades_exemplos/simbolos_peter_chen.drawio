        <mxCell id="e1t" value="Entidade forte: existe de forma independente e possui chave primária própria." style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="290" height="60" as="geometry"/></mxCell>

