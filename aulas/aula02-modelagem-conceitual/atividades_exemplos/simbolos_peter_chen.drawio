        <mxCell id="e3t" value="Entidade associativa: representa uma associação que precisa possuir atributos próprios." style="text;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="250" y="325" width="290" height="60" as="geometry"/></mxCell>

